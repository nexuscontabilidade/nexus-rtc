{
  "name": "nexus-testes-regras-firestore",
  "private": true,
  "description": "Testes das regras do Firestore no emulador (não faz parte do site)",
  "scripts": {
    "test": "firebase emulators:exec --only firestore --project demo-nexus-rules \"node --test --test-force-exit rules.test.js\" --config ../../firebase.json"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.0.0"
  }
}
