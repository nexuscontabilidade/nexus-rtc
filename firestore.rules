rules_version = '2';

/*
 * Nexus — regras de segurança do Cloud Firestore.
 *
 * Quem decide o que cada pessoa pode fazer é ESTE arquivo, no servidor — o código do site é público e pode ser alterado
 * por qualquer um no navegador, então nada que dependa dele é segurança.
 *
 * Coleções:
 *   users/{uid}                          perfil do acesso: nome, email, perfil, modulos, bloqueado...
 *       leitura:  o próprio usuário e administradores
 *       escrita:  SOMENTE administradores (cliente nunca altera o próprio perfil, módulos ou bloqueio)
 *   users/{uid}/stores/{rtc|lucro}       cabeçalho do repositório de dados do módulo (revisão)
 *   users/{uid}/stores/{id}/partes/{n}   conteúdo do repositório, em pedaços
 *       leitura/escrita: SOMENTE o dono (request.auth.uid == uid), sem bloqueio, com o módulo liberado.
 *       Administradores NÃO leem dados de clientes.
 *   qualquer outro caminho: negado.
 *
 * Primeiro administrador: criado manualmente no console (docs/FIREBASE.md) — as regras nunca permitem que alguém
 * se torne administrador sozinho.
 *
 * Ao criar um módulo novo, inclua o id dele em `modulosConhecidos()`.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- funções
    function logado() { return request.auth != null; }
    function refPerfil(uid) { return /databases/$(database)/documents/users/$(uid); }
    function temPerfil() { return logado() && exists(refPerfil(request.auth.uid)); }
    function meuPerfil() { return get(refPerfil(request.auth.uid)).data; }

    // conta com perfil cadastrado e não bloqueada
    function ativo() { return temPerfil() && meuPerfil().bloqueado != true; }
    function admin() { return ativo() && meuPerfil().perfil == 'admin'; }

    function modulosConhecidos() { return ['rtc', 'lucro']; }
    function moduloLiberado(m) {
      return ativo() && m in modulosConhecidos() && (
        meuPerfil().perfil == 'admin' ||
        meuPerfil().modulos == null ||
        (meuPerfil().modulos is list && m in meuPerfil().modulos));
    }

    function dono(uid) { return logado() && request.auth.uid == uid; }

    // formato obrigatório do perfil (impede campos extras ou valores fora do padrão)
    function perfilValido(d) {
      return d.keys().hasOnly(['nome', 'email', 'perfil', 'modulos', 'bloqueado', 'motivoBloqueio', 'bloqueadoEm', 'criadoEm', 'atualizadoEm'])
        && d.keys().hasAll(['nome', 'email', 'perfil', 'modulos', 'bloqueado'])
        && d.nome is string && d.nome.size() >= 2 && d.nome.size() <= 120
        && d.email is string && d.email.size() >= 5 && d.email.size() <= 254
        && d.perfil in ['admin', 'cliente']
        && d.bloqueado is bool
        && (d.modulos == null || (d.modulos is list && d.modulos.size() >= 1 && d.modulos.size() <= 2 && d.modulos.hasOnly(modulosConhecidos())))
        && (!('motivoBloqueio' in d) || (d.motivoBloqueio is string && d.motivoBloqueio.size() <= 300));
    }

    // ---------------------------------------------------------------- perfis
    match /users/{uid} {
      // o usuário lê o próprio perfil (inclusive bloqueado, para receber o aviso); administradores leem qualquer um
      allow get: if dono(uid) || admin();
      allow list: if admin();

      // administradores criam/alteram/removem perfis de OUTRAS pessoas. Em si mesmos, não podem mudar o próprio perfil
      // nem o bloqueio (evita ficar sem administrador) nem apagar o próprio cadastro.
      allow create: if admin() && !dono(uid) && perfilValido(request.resource.data);
      allow update: if admin() && perfilValido(request.resource.data)
        && request.resource.data.email == resource.data.email
        && (!dono(uid) || (request.resource.data.perfil == resource.data.perfil && request.resource.data.bloqueado == resource.data.bloqueado));
      allow delete: if admin() && !dono(uid);

      // ---------------------------------------------------------------- dados do cliente
      match /stores/{storeId} {
        allow read: if dono(uid) && moduloLiberado(storeId);

        // revisão sempre sobe de 1 em 1: duas abas/dispositivos não sobrescrevem um ao outro sem passar pelo conflito
        allow create: if dono(uid) && moduloLiberado(storeId)
          && request.resource.data.keys().hasOnly(['rev', 'partes', 'atualizadoEm'])
          && request.resource.data.rev == 1
          && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 60
          && request.resource.data.atualizadoEm == request.time;
        allow update: if dono(uid) && moduloLiberado(storeId)
          && request.resource.data.keys().hasOnly(['rev', 'partes', 'atualizadoEm'])
          && request.resource.data.rev == resource.data.rev + 1
          && request.resource.data.partes is int && request.resource.data.partes >= 1 && request.resource.data.partes <= 60
          && request.resource.data.atualizadoEm == request.time;
        allow delete: if false;

        match /partes/{parte} {
          allow read: if dono(uid) && moduloLiberado(storeId);
          allow create, update: if dono(uid) && moduloLiberado(storeId)
            && parte.matches('^[0-9]{1,2}$')
            && request.resource.data.keys().hasOnly(['rev', 'texto'])
            && request.resource.data.rev is int
            && request.resource.data.texto is string
            && request.resource.data.texto.size() <= 450000;
          allow delete: if dono(uid) && moduloLiberado(storeId);   // limpa partes que sobraram quando o conteúdo encolhe
        }
      }
    }

    // ---------------------------------------------------------------- todo o resto: negado
    match /{outro=**} {
      allow read, write: if false;
    }
  }
}
